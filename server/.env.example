# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...
# Speech-to-text (Groq Whisper by default). Without it, voice input is disabled.
# TRANSCRIBE_API_KEY=gsk_...
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Token the app must send. Leave unset to have one generated into data/api-token.
# API_TOKEN=
# PORT=3010
# 127.0.0.1 (default) = reachable only via Tailscale Serve; 0.0.0.0 = whole LAN.
# HOST=127.0.0.1
# ANTHROPIC_MODEL=claude-opus-5
# CONTEXT_MESSAGES=20
# RETENTION_DAYS=90
